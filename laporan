#!/usr/bin/env bash
# ==============================================================================
# Laporan Generator CLI Helper (./laporan)
# ==============================================================================
set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

show_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ========================================================"
    echo "                 LAPORAN GENERATOR CLI v2.4.0             "
    echo "     Otomatisasi Dokumen Akademik (Typst + DOCX Engine)   "
    echo "  ========================================================"
    echo -e "${NC}"
}

show_help() {
    show_banner
    echo -e "${BOLD}Penggunaan:${NC} ./laporan <perintah>"
    echo ""
    echo -e "${BOLD}Perintah yang Tersedia:${NC}"
    echo -e "  ${GREEN}build${NC}        Kompilasi PDF dan DOCX sekaligus"
    echo -e "  ${GREEN}pdf${NC}          Kompilasi dokumen PDF (via Typst)"
    echo -e "  ${GREEN}docx${NC}         Kompilasi dokumen Microsoft Word (.docx)"
    echo -e "  ${GREEN}init${NC}         Wizard interaktif untuk konfigurasi awal metadata"
    echo -e "  ${GREEN}preset${NC}       Kelola preset format kampus (list/show/apply/diff/validate)"
    echo -e "  ${GREEN}stats${NC}        Analisis statistik kata, halaman, gambar, dan durasi baca"
    echo -e "  ${GREEN}doctor${NC}       Audit kesehatan proyek (broken images, sitasi hilang, dll.)"
    echo -e "  ${GREEN}bundle${NC}       Kemas seluruh laporan (PDF, DOCX, MD) menjadi arsip zip"
    echo -e "  ${GREEN}check${NC}        Audit dependensi sistem dan struktur proyek"
    echo -e "  ${GREEN}test${NC}         Jalankan suite pengujian otomatis (test.sh)"
    echo -e "  ${GREEN}view${NC}         Buka dokumen Laporan.pdf di viewer"
    echo -e "  ${GREEN}watch${NC}        Pantau perubahan berkas dan auto-rebuild (live)"
    echo -e "  ${GREEN}clean${NC}        Bersihkan berkas output dan direktori sementara"
    echo -e "  ${GREEN}help${NC}         Tampilkan panduan bantuan ini"
    echo ""
    echo -e "${YELLOW}Contoh:${NC}"
    echo -e "  ./laporan build"
    echo -e "  ./laporan preset list"
    echo -e "  ./laporan preset apply itb-ta"
}

cmd_check() {
    show_banner
    echo -e "${BLUE}${BOLD}[1/2] Memeriksa Dependensi Sistem...${NC}"
    
    local all_ok=true

    check_dep() {
        local name="$1"
        local cmd="$2"
        local req="$3"
        if command -v "$cmd" &>/dev/null; then
            echo -e "  [${GREEN}OK${NC}] $name ($cmd) terpasang: $(command -v "$cmd")"
        else
            if [ "$req" = "required" ]; then
                echo -e "  [${RED}FAIL${NC}] $name ($cmd) ${RED}TIDAK DITEMUKAN${NC} (Wajib)"
                all_ok=false
            else
                echo -e "  [${YELLOW}INFO${NC}] $name ($cmd) tidak ditemukan (Opsional, untuk auto-inject nomor halaman Word)"
            fi
        fi
    }

    check_dep "Pandoc" "pandoc" "required"
    check_dep "Typst" "typst" "required"
    check_dep "ImageMagick" "magick" "required" 2>/dev/null || check_dep "ImageMagick" "convert" "required"
    check_dep "Python 3" "python3" "required"
    check_dep "LibreOffice" "soffice" "optional"

    echo ""
    echo -e "${BLUE}${BOLD}[2/2] Memeriksa Berkas Proyek...${NC}"
    
    check_file() {
        local file="$1"
        local desc="$2"
        if [ -f "$file" ]; then
            echo -e "  [${GREEN}OK${NC}] $desc ($file)"
        else
            echo -e "  [${RED}FAIL${NC}] $desc ($file) tidak ditemukan"
            all_ok=false
        fi
    }

    check_dir() {
        local dir="$1"
        local desc="$2"
        if [ -d "$dir" ]; then
            echo -e "  [${GREEN}OK${NC}] $desc ($dir)"
        else
            echo -e "  [${RED}FAIL${NC}] $desc ($dir) tidak ditemukan"
            all_ok=false
        fi
    }

    check_file "metadata.yml" "Metadata laporan"
    check_file "cover.md" "Kata pengantar & outline"
    check_file "template.typ" "Template Typst"
    check_file "reference.docx" "Template Word"
    check_file "references.bib" "Daftar pustaka"
    check_dir  "presets" "Direktori preset kampus"
    check_dir  "chapters" "Direktori bab laporan"

    echo ""
    if [ "$all_ok" = true ]; then
        echo -e "${GREEN}${BOLD}Semua dependensi dan berkas proyek lengkap dan siap digunakan!${NC}"
    else
        echo -e "${RED}${BOLD}Ada beberapa komponen yang kurang. Silakan lengkapi sebelum build.${NC}"
        echo -e "${YELLOW}Tips: Gunakan 'nix develop' atau Docker untuk instalasi instan.${NC}"
    fi
}

cmd_preset() {
    local subcmd="${1:-list}"
    case "$subcmd" in
        list)
            show_banner
            echo -e "${BLUE}${BOLD}Daftar Preset Format Kampus Tersedia:${NC}"
            echo ""
            if [ -d presets ]; then
                for p in presets/*.yml; do
                    if [ -f "$p" ]; then
                        local pid
                        pid=$(basename "$p" .yml)
                        local pname
                        pname=$(grep -E '^[[:space:]]*name:' "$p" 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '"\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                        local pdesc
                        pdesc=$(grep -E '^[[:space:]]*description:' "$p" 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '"\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                        echo -e "  * ${GREEN}${BOLD}$pid${NC} - ${BOLD}${pname:-$pid}${NC}"
                        if [ -n "$pdesc" ]; then
                            echo -e "    ${pdesc}"
                        fi
                        echo ""
                    fi
                done
            else
                echo -e "${RED}Direktori presets/ tidak ditemukan.${NC}"
            fi
            echo -e "${YELLOW}Perintah Terkait:${NC}"
            echo -e "  Pindai pedoman PDF : ${CYAN}./laporan preset scan <pedoman.pdf>${NC}"
            echo -e "  Lihat detail preset: ${CYAN}./laporan preset show <preset-id>${NC}"
            echo -e "  Bandingkan preset  : ${CYAN}./laporan preset diff <preset-1> [preset-2]${NC}"
            echo -e "  Validasi preset    : ${CYAN}./laporan preset validate [preset-id]${NC}"
            echo -e "  Terapkan preset    : ${CYAN}./laporan preset apply <preset-id>${NC}"
            ;;
        scan)
            local pdf_file="$2"
            if [ -z "$pdf_file" ]; then
                echo -e "${RED}Error: Masukkan path file PDF pedoman kampus.${NC}"
                echo "Contoh: ./laporan preset scan /path/ke/pedoman.pdf"
                exit 1
            fi
            if [ ! -f "$pdf_file" ]; then
                echo -e "${RED}Error: Berkas '$pdf_file' tidak ditemukan.${NC}"
                exit 1
            fi
            shift
            python3 scripts/scan-preset.py "$@"
            ;;
        validate)
            shift
            if [ -n "$1" ]; then
                local t="$1"
                [ -f "presets/${t}.yml" ] && t="presets/${t}.yml"
                python3 scripts/validate-preset.py "$t"
            else
                python3 scripts/validate-preset.py --all
            fi
            ;;
        diff)
            local p1="$2"
            local p2="$3"
            if [ -z "$p1" ]; then
                echo -e "${RED}Error: Sebutkan setidaknya 1 preset untuk dibandingkan.${NC}"
                echo "Contoh: ./laporan preset diff itb-ta ui-skripsi"
                exit 1
            fi
            if [ ! -f "presets/${p1}.yml" ]; then
                echo -e "${RED}Preset '${p1}' tidak ditemukan di folder presets/${NC}"
                exit 1
            fi
            show_banner
            if [ -n "$p2" ]; then
                if [ ! -f "presets/${p2}.yml" ]; then
                    echo -e "${RED}Preset '${p2}' tidak ditemukan di folder presets/${NC}"
                    exit 1
                fi
                echo -e "${CYAN}${BOLD}Perbandingan Preset: ${p1}  VS  ${p2}${NC}"
                echo "========================================================"
                diff -u "presets/${p1}.yml" "presets/${p2}.yml" || true
            else
                local curr
                curr=$(grep -E '^[[:space:]]*(preset|margin_preset):' metadata.yml 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '\"'\''\r\n ')
                curr=${curr:-"standard"}
                echo -e "${CYAN}${BOLD}Perbandingan: Aktif (${curr})  VS  Target (${p1})${NC}"
                echo "========================================================"
                diff -u "presets/${curr}.yml" "presets/${p1}.yml" 2>/dev/null || true
            fi
            echo "========================================================"
            ;;
        show)
            local target="$2"
            if [ -z "$target" ]; then
                echo -e "${RED}Error: Sebutkan ID preset. Contoh: ./laporan preset show itb-ta${NC}"
                exit 1
            fi
            if [ -f "presets/${target}.yml" ]; then
                show_banner
                echo -e "${CYAN}${BOLD}Konfigurasi Preset: ${target}${NC}"
                echo "--------------------------------------------------------"
                cat "presets/${target}.yml"
                echo "--------------------------------------------------------"
            else
                echo -e "${RED}Preset '${target}' tidak ditemukan di folder presets/${NC}"
                exit 1
            fi
            ;;
        apply)
            local target="$2"
            if [ -z "$target" ]; then
                echo -e "${RED}Error: Sebutkan ID preset. Contoh: ./laporan preset apply itb-ta${NC}"
                exit 1
            fi
            if [ ! -f "presets/${target}.yml" ]; then
                echo -e "${RED}Preset '${target}' tidak ditemukan di presets/${NC}"
                exit 1
            fi
            if [ ! -f "metadata.yml" ]; then
                echo -e "${RED}metadata.yml tidak ditemukan. Jalankan './laporan init' terlebih dahulu.${NC}"
                exit 1
            fi
            if grep -qE '^\s*preset:' metadata.yml; then
                sed -i.bak -E "s/^\s*preset:.*/preset: \"$target\"/" metadata.yml && rm -f metadata.yml.bak
            elif grep -qE '^\s*margin_preset:' metadata.yml; then
                sed -i.bak -E "s/^\s*margin_preset:.*/preset: \"$target\"/" metadata.yml && rm -f metadata.yml.bak
            elif grep -q '^\.\.\.' metadata.yml; then
                sed -i.bak -E "s/^\.\.\./preset: \"$target\"\n.../" metadata.yml && rm -f metadata.yml.bak
            else
                echo "preset: \"$target\"" >> metadata.yml
            fi
            echo -e "${GREEN}${BOLD}[OK] Preset '${target}' berhasil diterapkan ke metadata.yml!${NC}"
            ;;
        *)
            echo -e "${RED}Sub-perintah preset tidak dikenal: $subcmd${NC}"
            echo "Gunakan: ./laporan preset [list | scan <file> | show <id> | diff <id> | validate | apply <id>]"
            exit 1
            ;;
    esac
}

cmd_init() {
    show_banner
    echo -e "${CYAN}${BOLD}Wizard Konfigurasi Laporan Akademik${NC}"
    echo "Isi data di bawah ini (tekan Enter untuk memakai nilai default):"
    echo ""

    read -rp "Judul Laporan [LAPORAN PROYEK AKADEMIK]: " in_title
    in_title=${in_title:-"LAPORAN PROYEK AKADEMIK"}

    read -rp "Subjudul [DOKUMENTASI DAN ANALISIS IMPLEMENTASI]: " in_subtitle
    in_subtitle=${in_subtitle:-"DOKUMENTASI DAN ANALISIS IMPLEMENTASI"}

    read -rp "Mata Kuliah [Proyek Perangkat Lunak]: " in_course
    in_course=${in_course:-"Proyek Perangkat Lunak"}

    read -rp "Dosen Pengampu [Dr. Nama Dosen, M.Kom.]: " in_lecturer
    in_lecturer=${in_lecturer:-"Dr. Nama Dosen, M.Kom."}

    read -rp "Nama Penulis 1 [Nama Mahasiswa]: " in_author
    in_author=${in_author:-"Nama Mahasiswa"}

    read -rp "NIM Penulis 1 [12345678]: " in_nim
    in_nim=${in_nim:-"12345678"}

    read -rp "Institusi/Universitas [UNIVERSITAS TEKNOLOGI]: " in_institution
    in_institution=${in_institution:-"UNIVERSITAS TEKNOLOGI"}

    read -rp "Fakultas [FAKULTAS ILMU KOMPUTER]: " in_faculty
    in_faculty=${in_faculty:-"FAKULTAS ILMU KOMPUTER"}

    read -rp "Tahun Akademik [2026/2027]: " in_year
    in_year=${in_year:-"2026/2027"}

    echo ""
    echo -e "${BLUE}Pilihan Preset Format Kampus:${NC}"
    echo "  standard / skripsi-4433 / ui-skripsi / itb-ta / ugm-skripsi / its-skripsi"
    read -rp "Preset Format [standard]: " in_preset
    in_preset=${in_preset:-"standard"}

    cat << YAML_EOF > metadata.yml
title: "$in_title"
subtitle: "$in_subtitle"
course: "$in_course"
lecturer: "$in_lecturer"
author:
  - name: "$in_author"
    nim: "$in_nim"
institution: "$in_institution"
faculty: "$in_faculty"
year: "$in_year"
date: "$(date +'%B %Y')"
preset: "$in_preset"
YAML_EOF

    echo ""
    echo -e "${GREEN}${BOLD}metadata.yml berhasil diperbarui!${NC}"
    echo -e "Jalankan ${CYAN}./laporan build${NC} untuk mulai menghasilkan laporan."
}

cmd_build() {
    show_banner
    echo -e "${BLUE}${BOLD}1. Membangun Dokumen PDF (Typst Engine)...${NC}"
    ./build.sh
    echo ""
    echo -e "${BLUE}${BOLD}2. Membangun Dokumen Microsoft Word (DOCX Multi-Pass)...${NC}"
    make docx
    echo ""
    echo -e "${GREEN}${BOLD}Dokumen PDF dan DOCX berhasil dibuat!${NC}"
    echo -e "  - ${CYAN}Laporan.pdf${NC}"
    echo -e "  - ${CYAN}Laporan.docx${NC}"
}

cmd_pdf() {
    show_banner
    echo -e "${BLUE}${BOLD}Membangun Dokumen PDF...${NC}"
    ./build.sh
}

cmd_docx() {
    show_banner
    echo -e "${BLUE}${BOLD}Membangun Dokumen DOCX...${NC}"
    make docx
}

cmd_test() {
    show_banner
    echo -e "${BLUE}${BOLD}Menjalankan Test Suite...${NC}"
    ./test.sh
}

cmd_view() {
    make view
}

cmd_clean() {
    make clean
    echo -e "${GREEN}Berkas temporary berhasil dibersihkan.${NC}"
}

cmd_watch() {
    make watch
}

cmd_stats() {
    python3 scripts/report-stats.py
}

cmd_doctor() {
    python3 scripts/report-doctor.py
}

cmd_bundle() {
    python3 scripts/bundle.py
}

# Main routing
case "${1:-help}" in
    build)
        cmd_build
        ;;
    pdf)
        cmd_pdf
        ;;
    docx)
        cmd_docx
        ;;
    init)
        cmd_init
        ;;
    preset)
        shift
        cmd_preset "$@"
        ;;
    stats)
        cmd_stats
        ;;
    doctor)
        cmd_doctor
        ;;
    bundle)
        cmd_bundle
        ;;
    check)
        cmd_check
        ;;
    test)
        cmd_test
        ;;
    view)
        cmd_view
        ;;
    clean)
        cmd_clean
        ;;
    watch)
        cmd_watch
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Perintah tidak dikenal: $1${NC}"
        echo "Gunakan './laporan help' untuk melihat daftar perintah."
        exit 1
        ;;
esac
