    echo -e "${BOLD}${CYAN}3. MANAJEMEN PROYEK & PRESET:${NC}"
    echo -e "  ${GREEN}init${NC}                Inisialisasi template dokumen laporan di folder aktif"
    echo -e "  ${GREEN}import${NC}              Konversi berkas (DOCX, PDF, PPTX, XLSX) ke Markdown"
    echo -e "  ${GREEN}preset list${NC}         Tampilkan seluruh 14 preset kampus & jurnal"
    echo -e "  ${GREEN}preset show <id>${NC}    Tampilkan rincian konfigurasi preset kampus"
    echo -e "  ${GREEN}preset apply <id>${NC}   Terapkan konfigurasi preset ke metadata.yml lokal"
    echo -e "  ${GREEN}preset diff <id>${NC}    Bandingkan konfigurasi metadata lokal dengan preset"
    echo -e "  ${GREEN}bundle${NC}              Kemas laporan (PDF, DOCX, MD) menjadi arsip zip rilis"
    echo ""
