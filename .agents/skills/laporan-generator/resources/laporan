cmd_check() {
    show_banner
    echo -e "${BLUE}${BOLD}[1/2] Memeriksa Dependensi Sistem...${NC}"
    
    local all_ok=true

    check_dep() {
        local name="$1"
        local cmd="$2"
        local req="$3"
        if command -v "$cmd" &>/dev/null; then
            echo -e "  [${GREEN}OK${NC}] $name ($cmd) terpasang: $(command -v "$cmd")"
        else
            if [ "$req" = "required" ]; then
                echo -e "  [${RED}FAIL${NC}] $name ($cmd) ${RED}TIDAK DITEMUKAN${NC} (Wajib)"
                all_ok=false
            else
                echo -e "  [${YELLOW}INFO${NC}] $name ($cmd) tidak ditemukan (Opsional, untuk auto-inject nomor halaman Word)"
            fi
        fi
    }

    check_dep "Pandoc" "pandoc" "required"
    check_dep "Typst" "typst" "required"
    check_dep "ImageMagick" "magick" "required" 2>/dev/null || check_dep "ImageMagick" "convert" "required"
    check_dep "Python 3" "python3" "required"
    check_dep "LibreOffice" "soffice" "optional"

    echo ""
    echo -e "${BLUE}${BOLD}[2/2] Memeriksa Berkas Proyek...${NC}"
    
    check_file() {
        local file="$1"
        local desc="$2"
        if [ -f "$file" ]; then
            echo -e "  [${GREEN}OK${NC}] $desc ($file)"
        else
            echo -e "  [${RED}FAIL${NC}] $desc ($file) tidak ditemukan"
            all_ok=false
        fi
    }

    check_dir() {
        local dir="$1"
        local desc="$2"
        if [ -d "$dir" ]; then
            echo -e "  [${GREEN}OK${NC}] $desc ($dir)"
        else
            echo -e "  [${RED}FAIL${NC}] $desc ($dir) tidak ditemukan"
            all_ok=false
        fi
    }

    local tpl_prefix="$TARGET_DIR/"
    if [ ! -f "${tpl_prefix}metadata.yml" ] && [ -f "${tpl_prefix}templates/default/metadata.yml" ]; then
        tpl_prefix="${tpl_prefix}templates/default/"
    fi
    check_file "${tpl_prefix}metadata.yml" "Metadata laporan"
    check_file "${tpl_prefix}cover.md" "Kata pengantar & outline"
    check_file "${tpl_prefix}template.typ" "Template Typst"
    check_file "${tpl_prefix}reference.docx" "Template Word"
    check_file "${tpl_prefix}references.bib" "Daftar pustaka"
    if [ -d "$TARGET_DIR/presets" ]; then
        check_dir "$TARGET_DIR/presets" "Direktori preset kampus"
    else
        check_dir "$SCRIPT_DIR/presets" "Direktori preset kampus"
    fi
    check_dir  "${tpl_prefix}chapters" "Direktori bab laporan"

    echo ""
    if [ "$all_ok" = true ]; then
        echo -e "${GREEN}${BOLD}Semua dependensi dan berkas proyek lengkap dan siap digunakan!${NC}"
    else
        echo -e "${RED}${BOLD}Ada beberapa komponen yang kurang. Silakan lengkapi sebelum build.${NC}"
        echo -e "${YELLOW}Tips: Gunakan 'nix develop' atau Docker untuk instalasi instan.${NC}"
    fi
}

find_preset_file() {
    local name="$1"
    if [ -f "$TARGET_DIR/presets/${name}.yml" ]; then
        echo "$TARGET_DIR/presets/${name}.yml"
    elif [ -f "$SCRIPT_DIR/presets/${name}.yml" ]; then
        echo "$SCRIPT_DIR/presets/${name}.yml"
    fi
}

cmd_preset() {
    local subcmd="${1:-list}"
    case "$subcmd" in
        list)
            show_banner
            echo -e "${BLUE}${BOLD}Daftar Preset Format Kampus Tersedia:${NC}"
            echo ""
            local seen_presets=()
            local p_dirs=("$TARGET_DIR/presets" "$SCRIPT_DIR/presets")
            for pdir in "${p_dirs[@]}"; do
                if [ -d "$pdir" ]; then
                    for p in "$pdir"/*.yml; do
                        if [ -f "$p" ]; then
                            local pid
                            pid=$(basename "$p" .yml)
                            if [[ " ${seen_presets[*]} " =~ " ${pid} " ]]; then
                                continue
                            fi
                            seen_presets+=("$pid")
                            local pname
                            pname=$(grep -E '^[[:space:]]*name:' "$p" 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '"\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                            local pdesc
                            pdesc=$(grep -E '^[[:space:]]*description:' "$p" 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '"\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                            echo -e "  * ${GREEN}${BOLD}$pid${NC} - ${BOLD}${pname:-$pid}${NC}"
                            if [ -n "$pdesc" ]; then
                                echo -e "    ${pdesc}"
                            fi
                            echo ""
                        fi
                    done
                fi
            done
            echo -e "${YELLOW}Perintah Terkait:${NC}"
            echo -e "  Pindai pedoman PDF : ${CYAN}./laporan preset scan <pedoman.pdf>${NC}"
            echo -e "  Lihat detail preset: ${CYAN}./laporan preset show <preset-id>${NC}"
            echo -e "  Bandingkan preset  : ${CYAN}./laporan preset diff <preset-1> [preset-2]${NC}"
            echo -e "  Validasi preset    : ${CYAN}./laporan preset validate [preset-id]${NC}"
            echo -e "  Terapkan preset    : ${CYAN}./laporan preset apply <preset-id>${NC}"
            ;;
        scan)
            local pdf_file="$2"
            if [ -z "$pdf_file" ]; then
                echo -e "${RED}Error: Masukkan path file PDF pedoman kampus.${NC}"
                echo "Contoh: ./laporan preset scan /path/ke/pedoman.pdf"
                exit 1
            fi
            if [ ! -f "$pdf_file" ]; then
                echo -e "${RED}Error: Berkas '$pdf_file' tidak ditemukan.${NC}"
                exit 1
            fi
            shift
            python3 "$SCRIPT_DIR/scripts/scan-preset.py" "$@"
            ;;
        validate)
            shift
            if [ -n "$1" ]; then
                local t="$1"
                local p_file
                p_file=$(find_preset_file "$t")
                [ -n "$p_file" ] && t="$p_file"
                python3 "$SCRIPT_DIR/scripts/validate-preset.py" "$t"
            else
                python3 "$SCRIPT_DIR/scripts/validate-preset.py" --all
            fi
            ;;
        diff)
            local p1="$2"
            local p2="$3"
            if [ -z "$p1" ]; then
                echo -e "${RED}Error: Sebutkan setidaknya 1 preset untuk dibandingkan.${NC}"
                echo "Contoh: ./laporan preset diff itb-ta ui-skripsi"
                exit 1
            fi
            local p1_file
            p1_file=$(find_preset_file "$p1")
            if [ -z "$p1_file" ] || [ ! -f "$p1_file" ]; then
                echo -e "${RED}Preset '${p1}' tidak ditemukan di folder presets/${NC}"
                exit 1
            fi
            show_banner
            if [ -n "$p2" ]; then
                local p2_file
                p2_file=$(find_preset_file "$p2")
                if [ -z "$p2_file" ] || [ ! -f "$p2_file" ]; then
                    echo -e "${RED}Preset '${p2}' tidak ditemukan di folder presets/${NC}"
                    exit 1
                fi
                echo -e "${CYAN}${BOLD}Perbandingan Preset: ${p1}  VS  ${p2}${NC}"
                echo "========================================================"
                diff -u "$p1_file" "$p2_file" || true
            else
                local curr_meta="$TARGET_DIR/metadata.yml"
                [ ! -f "$curr_meta" ] && [ -f "$TARGET_DIR/templates/default/metadata.yml" ] && curr_meta="$TARGET_DIR/templates/default/metadata.yml"
                local curr
                curr=$(grep -E '^[[:space:]]*(preset|margin_preset):' "$curr_meta" 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '\"'\''\r\n ')
                curr=${curr:-"standard"}
                local curr_file
                curr_file=$(find_preset_file "$curr")
                echo -e "${CYAN}${BOLD}Perbandingan: Aktif (${curr})  VS  Target (${p1})${NC}"
                echo "========================================================"
                if [ -n "$curr_file" ] && [ -f "$curr_file" ]; then
                    diff -u "$curr_file" "$p1_file" || true
                fi
            fi
            echo "========================================================"
            ;;
        show)
            local target="$2"
            if [ -z "$target" ]; then
                echo -e "${RED}Error: Sebutkan ID preset. Contoh: ./laporan preset show itb-ta${NC}"
                exit 1
            fi
            local p_file
            p_file=$(find_preset_file "$target")
            if [ -n "$p_file" ] && [ -f "$p_file" ]; then
                show_banner
                echo -e "${CYAN}${BOLD}Konfigurasi Preset: ${target}${NC}"
                echo "--------------------------------------------------------"
                cat "$p_file"
                echo "--------------------------------------------------------"
            else
                echo -e "${RED}Preset '${target}' tidak ditemukan di folder presets/${NC}"
                exit 1
            fi
            ;;
        apply)
            local target="$2"
            if [ -z "$target" ]; then
                echo -e "${RED}Error: Sebutkan ID preset. Contoh: ./laporan preset apply itb-ta${NC}"
                exit 1
            fi
            local p_file
            p_file=$(find_preset_file "$target")
            if [ -z "$p_file" ] || [ ! -f "$p_file" ]; then
                echo -e "${RED}Preset '${target}' tidak ditemukan di presets/${NC}"
                exit 1
            fi
            local meta_target="$TARGET_DIR/metadata.yml"
            if [ ! -f "$meta_target" ] && [ -f "$TARGET_DIR/templates/default/metadata.yml" ]; then
                meta_target="$TARGET_DIR/templates/default/metadata.yml"
            fi
            if [ ! -f "$meta_target" ]; then
                echo -e "${RED}metadata.yml tidak ditemukan. Jalankan './laporan init' terlebih dahulu.${NC}"
                exit 1
            fi
            if grep -qE '^\s*preset:' "$meta_target"; then
                sed -i.bak -E "s/^\s*preset:.*/preset: \"$target\"/" "$meta_target" && rm -f "${meta_target}.bak"
            elif grep -qE '^\s*margin_preset:' "$meta_target"; then
                sed -i.bak -E "s/^\s*margin_preset:.*/preset: \"$target\"/" "$meta_target" && rm -f "${meta_target}.bak"
            elif grep -q '^\.\.\.' "$meta_target"; then
                sed -i.bak -E "s/^\.\.\./preset: \"$target\"\n.../" "$meta_target" && rm -f "${meta_target}.bak"
            else
                echo "preset: \"$target\"" >> "$meta_target"
            fi
            echo -e "${GREEN}${BOLD}[OK] Preset '${target}' berhasil diterapkan ke ${meta_target}!${NC}"
            ;;
        *)
            echo -e "${RED}Sub-perintah preset tidak dikenal: $subcmd${NC}"
            echo "Gunakan: ./laporan preset [list | scan <file> | show <id> | diff <id> | validate | apply <id>]"
            exit 1
            ;;
    esac
}

yaml_escape() {
    local val="$1"
    val="${val//\\/\\\\}"
    val="${val//\"/\\\"}"
    val="${val//$'\r'/}"
    val="${val//$'\n'/ }"
    echo -n "$val"
}

cmd_init() {
    show_banner
    echo -e "${CYAN}${BOLD}Wizard Konfigurasi Laporan Akademik${NC}"
    echo "Isi data di bawah ini (tekan Enter untuk memakai nilai default):"
    echo ""

    read -rp "Judul Laporan [LAPORAN PROYEK AKADEMIK]: " in_title
    in_title=${in_title:-"LAPORAN PROYEK AKADEMIK"}

    read -rp "Subjudul [DOKUMENTASI DAN ANALISIS IMPLEMENTASI]: " in_subtitle
    in_subtitle=${in_subtitle:-"DOKUMENTASI DAN ANALISIS IMPLEMENTASI"}

    read -rp "Mata Kuliah [Proyek Perangkat Lunak]: " in_course
    in_course=${in_course:-"Proyek Perangkat Lunak"}

    read -rp "Dosen Pengampu [Dr. Nama Dosen, M.Kom.]: " in_lecturer
    in_lecturer=${in_lecturer:-"Dr. Nama Dosen, M.Kom."}

    read -rp "Nama Penulis 1 [Nama Mahasiswa]: " in_author
    in_author=${in_author:-"Nama Mahasiswa"}

    read -rp "NIM Penulis 1 [12345678]: " in_nim
    in_nim=${in_nim:-"12345678"}

    read -rp "Institusi/Universitas [UNIVERSITAS TEKNOLOGI]: " in_institution
    in_institution=${in_institution:-"UNIVERSITAS TEKNOLOGI"}

    read -rp "Fakultas [FAKULTAS ILMU KOMPUTER]: " in_faculty
    in_faculty=${in_faculty:-"FAKULTAS ILMU KOMPUTER"}

    read -rp "Tahun Akademik [2026/2027]: " in_year
    in_year=${in_year:-"2026/2027"}

    echo ""
    echo -e "${BLUE}Pilihan Preset Format Kampus:${NC}"
    echo "  standard / skripsi-4433 / ui-skripsi / itb-ta / ugm-skripsi / its-skripsi"
    read -rp "Preset Format [standard]: " in_preset
    in_preset=${in_preset:-"standard"}

    cat << YAML_EOF > metadata.yml
title: "$(yaml_escape "$in_title")"
subtitle: "$(yaml_escape "$in_subtitle")"
course: "$(yaml_escape "$in_course")"
lecturer: "$(yaml_escape "$in_lecturer")"
author:
  - name: "$(yaml_escape "$in_author")"
    nim: "$(yaml_escape "$in_nim")"
institution: "$(yaml_escape "$in_institution")"
faculty: "$(yaml_escape "$in_faculty")"
year: "$(yaml_escape "$in_year")"
date: "$(date +'%B %Y')"
preset: "$(yaml_escape "$in_preset")"
YAML_EOF

    echo ""
    echo -e "${GREEN}${BOLD}metadata.yml berhasil diperbarui!${NC}"
    echo -e "Jalankan ${CYAN}./laporan build${NC} untuk mulai menghasilkan laporan."
}

cmd_build() {
    show_banner
    echo -e "${BLUE}${BOLD}1. Membangun Dokumen PDF (Typst Engine)...${NC}"
    "$SCRIPT_DIR/build.sh" "$TARGET_DIR"
    echo ""
    echo -e "${BLUE}${BOLD}2. Membangun Dokumen Microsoft Word (DOCX Multi-Pass)...${NC}"
    "$SCRIPT_DIR/build-docx.sh" "$TARGET_DIR"
    echo ""
    echo -e "${GREEN}${BOLD}Dokumen PDF dan DOCX berhasil dibuat!${NC}"
    echo -e "  - ${CYAN}${TARGET_DIR}/Laporan.pdf${NC}"
    echo -e "  - ${CYAN}${TARGET_DIR}/Laporan.docx${NC}"
}

cmd_pdf() {
    show_banner
    echo -e "${BLUE}${BOLD}Membangun Dokumen PDF...${NC}"
    "$SCRIPT_DIR/build.sh" "$TARGET_DIR"
}

cmd_docx() {
    show_banner
    echo -e "${BLUE}${BOLD}Membangun Dokumen DOCX...${NC}"
    "$SCRIPT_DIR/build-docx.sh" "$TARGET_DIR"
}

cmd_test() {
    show_banner
    echo -e "${BLUE}${BOLD}Menjalankan Test Suite...${NC}"
    (cd "$SCRIPT_DIR" && ./test.sh)
}

cmd_view() {
    local pdf_target="$TARGET_DIR/Laporan.pdf"
    if [ ! -f "$pdf_target" ] && [ -f "$TARGET_DIR/templates/default/Laporan.pdf" ]; then
        pdf_target="$TARGET_DIR/templates/default/Laporan.pdf"
    fi
    if [ -f "$pdf_target" ]; then
        command -v xdg-open >/dev/null 2>&1 && xdg-open "$pdf_target" || open "$pdf_target" || echo "Laporan.pdf ada di: $pdf_target"
    else
        echo -e "${RED}ERROR: Laporan.pdf belum dibuat. Jalankan 'laporan build' terlebih dahulu.${NC}"
        exit 1
    fi
}

cmd_clean() {
    rm -f "$TARGET_DIR/Laporan.pdf" "$TARGET_DIR/Laporan.docx" "$TARGET_DIR/Laporan.html"
    rm -f "$TARGET_DIR/templates/default/Laporan.pdf" "$TARGET_DIR/templates/default/Laporan.docx" "$TARGET_DIR/templates/default/Laporan.html"
    rm -rf "$TARGET_DIR/tmp/"
    echo -e "${GREEN}Berkas temporary berhasil dibersihkan.${NC}"
}

cmd_watch() {
    command -v inotifywait >/dev/null 2>&1 || { echo "ERROR: inotifywait not found. Install inotify-tools."; exit 1; }
    echo "Watching for changes in $TARGET_DIR... (Ctrl+C to stop)"
    while true; do
        inotifywait -r -e modify -e create -e delete "$TARGET_DIR" \
            --exclude '(Laporan\.pdf|Laporan\.docx|tmp/|\.git/|\.pdf)' 2>/dev/null
        "$SCRIPT_DIR/build.sh" "$TARGET_DIR"
    done
}

cmd_stats() {
    python3 "$SCRIPT_DIR/scripts/report-stats.py" "$TARGET_DIR"
}

cmd_doctor() {
    python3 "$SCRIPT_DIR/scripts/report-doctor.py" "$TARGET_DIR"
}

cmd_bundle() {
    python3 "$SCRIPT_DIR/scripts/bundle.py" "$TARGET_DIR"
}

cmd_audit() {
    local py_bin="python3"
    command -v python3 >/dev/null 2>&1 || py_bin="python"
    "$py_bin" "$SCRIPT_DIR/scripts/audit-forensics.py" --dir "$TARGET_DIR" "$@"
}

cmd_citations() {
    if [ "$1" = "verify" ]; then
        shift
        local py_bin="python3"
        command -v python3 >/dev/null 2>&1 || py_bin="python"
        local bib_target="$TARGET_DIR/references.bib"
        if [ ! -f "$bib_target" ] && [ -f "$TARGET_DIR/templates/default/references.bib" ]; then
            bib_target="$TARGET_DIR/templates/default/references.bib"
        fi
        "$py_bin" "$SCRIPT_DIR/scripts/verify-citations.py" --bib "$bib_target" "$@"
    else
        echo "Penggunaan: ./laporan citations verify [--bib path/to/references.bib]"
    fi
}

case "${1:-help}" in
    build)
        cmd_build
        ;;
    pdf)
        cmd_pdf
        ;;
    docx)
        cmd_docx
        ;;
    init)
        cmd_init
        ;;
    import|ingest)
        shift
        cmd_import "$@"
        ;;
    preset)
        shift
        cmd_preset "$@"
        ;;
    stats)
        cmd_stats
        ;;
    audit|forensics)
        shift
        cmd_audit "$@"
        ;;
    citations)
        shift
        cmd_citations "$@"
        ;;
    doctor)
        cmd_doctor
        ;;
    bundle)
        cmd_bundle
        ;;
    setup)
        bash "$SCRIPT_DIR/scripts/setup-deps.sh"
        ;;
    mcp|server)
        shift
        if command -v node >/dev/null 2>&1; then
            if [ -f "bin/mcp-server.js" ]; then
                node bin/mcp-server.js "$@"
            elif command -v npx >/dev/null 2>&1; then
                npx -y laporan-generator mcp "$@"
            else
                echo "Berkas bin/mcp-server.js tidak ditemukan dan npx tidak tersedia."
                exit 1
            fi
        else
            echo "Node.js diperlukan untuk menjalankan MCP Server."
            exit 1
        fi
        ;;
    sync-skills|sync-hosts)
        shift
        if command -v node >/dev/null 2>&1; then
            if [ -f "bin/laporan-generator.js" ]; then
                node bin/laporan-generator.js sync-hosts "$@"
            elif command -v npx >/dev/null 2>&1; then
                npx -y laporan-generator sync-hosts "$@"
            else
                echo "Berkas bin/laporan-generator.js tidak ditemukan dan npx tidak tersedia."
                exit 1
            fi
        else
            echo "Node.js diperlukan untuk sinkronisasi multi-host AI agent."
        fi
        ;;
    uninstall|clean-skills)
        shift
        if command -v node >/dev/null 2>&1; then
            if [ -f "bin/laporan-generator.js" ]; then
                node bin/laporan-generator.js uninstall "$@"
            elif command -v npx >/dev/null 2>&1; then
                npx -y laporan-generator uninstall "$@"
            else
                echo "Berkas bin/laporan-generator.js tidak ditemukan dan npx tidak tersedia."
                exit 1
            fi
        else
            echo "Node.js diperlukan untuk membersihkan integrasi AI agent."
        fi
        ;;
    check)
        cmd_check
        ;;
    test)
        cmd_test
        ;;
    view)
        cmd_view
        ;;
    clean)
        cmd_clean
        ;;
    watch)
        cmd_watch
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Perintah tidak dikenal: $1${NC}"
        echo "Gunakan './laporan help' untuk melihat daftar perintah."
        exit 1
        ;;
esac
