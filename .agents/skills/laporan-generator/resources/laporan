    echo -e "  ${GREEN}mcp${NC}                 Jalankan native MCP Server untuk AI Agent"
    echo -e "  ${GREEN}sync-skills${NC}         Sinkronkan MCP & skills ke Antigravity, Claude, OpenCode"
    echo -e "  ${GREEN}setup${NC}               Pasang dependensi otomatis (Linux, macOS, Nix, Docker)"
    echo -e "  ${GREEN}uninstall${NC}           Hapus integrasi skills & symlinks dari sistem"
    echo ""
    echo -e "${BOLD}${YELLOW}Opsi Tambahan:${NC}"
    echo -e "  ${YELLOW}--preset <id>${NC}       Tentukan preset saat init/build"
    echo -e "  ${YELLOW}--strict${NC}            Gagal jika probabilitas AI melebihi 15 persen"
    echo -e "  ${YELLOW}--json${NC}              Keluarkan output dalam format JSON terstruktur"
    echo -e "  ${YELLOW}--all${NC}               Audit seluruh berkas Markdown di dalam proyek"
    echo ""
    echo -e "${BOLD}${YELLOW}Contoh:${NC}"
